{% extends "../partials/layout.njk" %}

{% set pageTitle = "New starter guide to government digital, data and technology" %}
{% set containerClasses = "govuk-width-container" %}
{% set mainClasses = "govuk-main-wrapper govuk-body" %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-xl">{{ pageTitle }}</h1>

      <p class="govuk-body-l">
        “Use this guide to understand how government service teams work, find trusted guidance and connect with people across government.”
      </p>

      <p class="govuk-body">
        “Work through the steps in this suggested order. You can return to the guide whenever you need it. Your organisation may also have its own induction, policies and communities.”
      </p>

      <div class="govuk-!-margin-top-7">
        {# GOV.UK provides this Step by Step pattern for prototypes and early usability testing. The production approach should be reviewed after testing. #}
        <div
          class="app-step-nav"
          data-module="app-step-nav"
          data-id="new-starter-guide"
          data-show-text="Show"
          data-hide-text="Hide"
          data-show-all-text="Show all steps"
          data-hide-all-text="Hide all steps"
        >
          <ol class="app-step-nav__steps">
            <li class="app-step-nav__step js-step" id="step-1" data-show-hide="1">
              <div class="app-step-nav__header js-step-title" data-position="1">
                <h2 class="app-step-nav__title" id="step-title-1">
                  <span class="app-step-nav__circle app-step-nav__circle--number">
                    <span class="app-step-nav__circle-inner">
                      <span class="app-step-nav__circle-background">
                        <span class="app-step-nav__circle-step-label govuk-visually-hidden">Step</span>
                        <span class="app-step-nav__circle-step">1</span>
                      </span>
                    </span>
                  </span>
                  <span class="app-step-nav__title-text">Understand the basics</span>
                </h2>
                <button
                  type="button"
                  class="app-step-nav__button js-step-title-button"
                  aria-expanded="true"
                  aria-controls="step-panel-1"
                  aria-labelledby="step-title-1 step-panel-1"
                >
                  <span class="app-step-nav__button-text">Hide</span>
                  <span class="app-step-nav__button-icon" aria-hidden="true"></span>
                </button>
              </div>

              <div class="app-step-nav__panel js-panel" id="step-panel-1" aria-labelledby="step-title-1">
                <p class="govuk-body">Start with the guidance, standards and principles used by government digital, data and technology teams.</p>

                <ol class="govuk-list govuk-list--number">
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual">Read the GOV.UK Service Manual</a>
                    </p>
                    <p class="govuk-body">Guidance for creating and running public services that meet the Service Standard.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://ddat-capability-framework.service.gov.uk/">Explore the Government Digital and Data Profession Capability Framework</a>
                    </p>
                    <p class="govuk-body">Find government roles and the skills needed to do them.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/service-standard">Understand the Service Standard</a>
                    </p>
                    <p class="govuk-body">Learn about the 14 points used to define a good government service.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/service-assessments">Learn about service assessments</a>
                    </p>
                    <p class="govuk-body">Check whether a service needs an assessment and how to apply the Service Standard.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/guidance/government-design-principles">Read the Government Design Principles</a>
                    </p>
                    <p class="govuk-body">Use the principles to design simple, inclusive and sustainable services.</p>
                  </li>
                </ol>
              </div>
            </li>

            <li class="app-step-nav__step js-step" id="step-2" data-show-hide="2">
              <div class="app-step-nav__header js-step-title" data-position="2">
                <h2 class="app-step-nav__title" id="step-title-2">
                  <span class="app-step-nav__circle app-step-nav__circle--number">
                    <span class="app-step-nav__circle-inner">
                      <span class="app-step-nav__circle-background">
                        <span class="app-step-nav__circle-step-label govuk-visually-hidden">Step</span>
                        <span class="app-step-nav__circle-step">2</span>
                      </span>
                    </span>
                  </span>
                  <span class="app-step-nav__title-text">Learn how service teams work</span>
                </h2>
                <button
                  type="button"
                  class="app-step-nav__button js-step-title-button"
                  aria-expanded="false"
                  aria-controls="step-panel-2"
                  aria-labelledby="step-title-2 step-panel-2"
                >
                  <span class="app-step-nav__button-text">Show</span>
                  <span class="app-step-nav__button-icon" aria-hidden="true"></span>
                </button>
              </div>

              <div class="app-step-nav__panel js-panel" id="step-panel-2" aria-labelledby="step-title-2">
                <p class="govuk-body">Learn how multidisciplinary service teams work and how services move through different phases.</p>

                <ol class="govuk-list govuk-list--number">
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/agile-delivery">Learn about agile delivery</a>
                    </p>
                    <p class="govuk-body">Read guidance about agile methods, service phases and governance.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/the-team/what-each-role-does-in-service-team">Understand what each role does in a service team</a>
                    </p>
                    <p class="govuk-body">Learn about responsibilities within a multidisciplinary service team.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/agile-delivery/how-the-discovery-phase-works">Understand discovery, alpha, beta and live</a>
                    </p>
                    <p class="govuk-body">Find out what teams do and learn during each phase of a service.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.security.gov.uk/policy-and-guidance/secure-by-design/">Follow Secure by Design guidance</a>
                    </p>
                    <p class="govuk-body">Build effective security practices into digital services from the start.</p>
                  </li>
                </ol>
              </div>
            </li>

            <li class="app-step-nav__step js-step" id="step-3" data-show-hide="3">
              <div class="app-step-nav__header js-step-title" data-position="3">
                <h2 class="app-step-nav__title" id="step-title-3">
                  <span class="app-step-nav__circle app-step-nav__circle--number">
                    <span class="app-step-nav__circle-inner">
                      <span class="app-step-nav__circle-background">
                        <span class="app-step-nav__circle-step-label govuk-visually-hidden">Step</span>
                        <span class="app-step-nav__circle-step">3</span>
                      </span>
                    </span>
                  </span>
                  <span class="app-step-nav__title-text">Make services accessible and inclusive</span>
                </h2>
                <button
                  type="button"
                  class="app-step-nav__button js-step-title-button"
                  aria-expanded="false"
                  aria-controls="step-panel-3"
                  aria-labelledby="step-title-3 step-panel-3"
                >
                  <span class="app-step-nav__button-text">Show</span>
                  <span class="app-step-nav__button-icon" aria-hidden="true"></span>
                </button>
              </div>

              <div class="app-step-nav__panel js-panel" id="step-panel-3" aria-labelledby="step-title-3">
                <p class="govuk-body">Understand how to make services accessible and support people who cannot use digital services independently.</p>

                <ol class="govuk-list govuk-list--number">
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/helping-people-to-use-your-service/making-your-service-accessible-an-introduction">Learn how to make a service accessible</a>
                    </p>
                    <p class="govuk-body">Understand government accessibility requirements and your team’s responsibilities.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/helping-people-to-use-your-service/testing-for-accessibility">Test against Web Content Accessibility Guidelines 2.2</a>
                    </p>
                    <p class="govuk-body">Test code, content and journeys with disabled users and assistive technologies.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/assisted-digital/">Plan assisted digital support</a>
                    </p>
                    <p class="govuk-body">Learn when users may need help to use the online parts of a service.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/helping-people-to-use-your-service/how-your-assisted-digital-support-will-be-assessed">Learn how assisted digital support is assessed</a>
                    </p>
                    <p class="govuk-body">Show how research, support design and testing meet users’ needs.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/helping-people-to-use-your-service/getting-an-accessibility-audit">Get an accessibility audit</a>
                    </p>
                    <p class="govuk-body">Plan an audit and allow time to fix the issues it finds.</p>
                  </li>
                </ol>
              </div>
            </li>

            <li class="app-step-nav__step js-step" id="step-4" data-show-hide="4">
              <div class="app-step-nav__header js-step-title" data-position="4">
                <h2 class="app-step-nav__title" id="step-title-4">
                  <span class="app-step-nav__circle app-step-nav__circle--number">
                    <span class="app-step-nav__circle-inner">
                      <span class="app-step-nav__circle-background">
                        <span class="app-step-nav__circle-step-label govuk-visually-hidden">Step</span>
                        <span class="app-step-nav__circle-step">4</span>
                      </span>
                    </span>
                  </span>
                  <span class="app-step-nav__title-text">Use research and evidence</span>
                </h2>
                <button
                  type="button"
                  class="app-step-nav__button js-step-title-button"
                  aria-expanded="false"
                  aria-controls="step-panel-4"
                  aria-labelledby="step-title-4 step-panel-4"
                >
                  <span class="app-step-nav__button-text">Show</span>
                  <span class="app-step-nav__button-icon" aria-hidden="true"></span>
                </button>
              </div>

              <div class="app-step-nav__panel js-panel" id="step-panel-4" aria-labelledby="step-title-4">
                <p class="govuk-body">Start with evidence, learn about users and check what other teams already know before designing a solution.</p>

                <ol class="govuk-list govuk-list--number">
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/user-research/start-by-learning-user-needs">Start by learning about users and their needs</a>
                    </p>
                    <p class="govuk-body">Understand users’ goals, problems and context before building anything.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/user-research/plan-user-research-for-your-service">Plan user research for your service</a>
                    </p>
                    <p class="govuk-body">Set research objectives, choose methods and share findings with the team.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://research.localgov.digital/">Search the local government user research library</a>
                    </p>
                    <p class="govuk-body">Find existing research and insights from local government teams.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="/">Search the GOV Reuse Library</a>
                    </p>
                    <p class="govuk-body">Find existing components, patterns, standards and guidance before starting again.</p>
                  </li>
                </ol>
              </div>
            </li>

            <li class="app-step-nav__step js-step" id="step-5" data-show-hide="5">
              <div class="app-step-nav__header js-step-title" data-position="5">
                <h2 class="app-step-nav__title" id="step-title-5">
                  <span class="app-step-nav__circle app-step-nav__circle--number">
                    <span class="app-step-nav__circle-inner">
                      <span class="app-step-nav__circle-background">
                        <span class="app-step-nav__circle-step-label govuk-visually-hidden">Step</span>
                        <span class="app-step-nav__circle-step">5</span>
                      </span>
                    </span>
                  </span>
                  <span class="app-step-nav__title-text">Use artificial intelligence responsibly</span>
                </h2>
                <button
                  type="button"
                  class="app-step-nav__button js-step-title-button"
                  aria-expanded="false"
                  aria-controls="step-panel-5"
                  aria-labelledby="step-title-5 step-panel-5"
                >
                  <span class="app-step-nav__button-text">Show</span>
                  <span class="app-step-nav__button-icon" aria-hidden="true"></span>
                </button>
              </div>

              <div class="app-step-nav__panel js-panel" id="step-panel-5" aria-labelledby="step-title-5">
                <p class="govuk-body">Understand the opportunities, limitations and responsibilities involved in using artificial intelligence (AI). Always follow your organisation’s policies.</p>

                <ol class="govuk-list govuk-list--number">
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/government/publications/ai-playbook-for-the-uk-government/artificial-intelligence-playbook-for-the-uk-government-html">Read the AI Playbook for the UK Government</a>
                    </p>
                    <p class="govuk-body">Follow 10 principles for using AI safely, effectively and securely in government.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/government/publications/ministry-of-justice-ai-and-data-science-ethics-framework">Use the Ministry of Justice AI and Data Science Ethics Framework</a>
                    </p>
                    <p class="govuk-body">Use tools and guidance for ethical reflection throughout a project.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/communities/artificial-intelligence-community">Join the artificial intelligence community of practice</a>
                    </p>
                    <p class="govuk-body">Connect with people interested in using AI across government.</p>
                  </li>
                </ol>
              </div>
            </li>

            <li class="app-step-nav__step js-step" id="step-6" data-show-hide="6">
              <div class="app-step-nav__header js-step-title" data-position="6">
                <h2 class="app-step-nav__title" id="step-title-6">
                  <span class="app-step-nav__circle app-step-nav__circle--number">
                    <span class="app-step-nav__circle-inner">
                      <span class="app-step-nav__circle-background">
                        <span class="app-step-nav__circle-step-label govuk-visually-hidden">Step</span>
                        <span class="app-step-nav__circle-step">6</span>
                      </span>
                    </span>
                  </span>
                  <span class="app-step-nav__title-text">Connect, reuse and keep learning</span>
                </h2>
                <button
                  type="button"
                  class="app-step-nav__button js-step-title-button"
                  aria-expanded="false"
                  aria-controls="step-panel-6"
                  aria-labelledby="step-title-6 step-panel-6"
                >
                  <span class="app-step-nav__button-text">Show</span>
                  <span class="app-step-nav__button-icon" aria-hidden="true"></span>
                </button>
              </div>

              <div class="app-step-nav__panel js-panel" id="step-panel-6" aria-labelledby="step-title-6">
                <p class="govuk-body">Connect with practitioners, learn from existing work and share resources that could help other service teams.</p>

                <ol class="govuk-list govuk-list--number">
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.gov.uk/service-manual/communities">Find cross-government communities of practice</a>
                    </p>
                    <p class="govuk-body">Find profession and topic communities across government.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="/">Explore the GOV Reuse Library</a>
                    </p>
                    <p class="govuk-body">Search government design systems, manuals, standards, products and style guides.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="https://www.futurelearn.com/partners/government-campus-uk">Explore Government Digital and Data courses on FutureLearn</a>
                    </p>
                    <p class="govuk-body">Find short courses for new starters and people developing their skills. A FutureLearn account is required and some access options are limited or paid.</p>
                  </li>
                  <li>
                    <p class="govuk-body">
                      <a class="govuk-link" href="/contribute">Suggest a resource</a>
                    </p>
                    <p class="govuk-body">Help keep the library useful, accurate and up to date.</p>
                  </li>
                </ol>
              </div>
            </li>
          </ol>
        </div>
      </div>

      <div class="govuk-!-margin-top-7">
        <h2 class="govuk-heading-m">Help improve this guide</h2>
        <p class="govuk-body">Tell the GOV Reuse Library team about missing, unclear or out-of-date resources.</p>
        <p class="govuk-body">
          <a class="govuk-link" href="/contribute">Suggest a resource or update</a>
        </p>
      </div>
    </div>
  </div>
{% endblock %}
