{% extends "govuk/template.njk" %}

{% from "govuk/components/service-navigation/macro.njk" import govukServiceNavigation %}
{% from "govuk/components/header/macro.njk" import govukHeader %}
{% from "govuk/components/skip-link/macro.njk" import govukSkipLink %}

{% block head %}
  <link href="{{ '/assets/css/index.css' | assetMap }}" rel="stylesheet"/>
{% endblock %}

{% block pageTitle %}{{pageTitle | default(applicationName)}}{% endblock %}
{%  set themeColor = "#ca357c" %}

{% block bodyStart %}
  {% include "./cookieBanner.njk" %}
{% endblock %}

{% block headerStart %}
  {# show content after cookie banner but before the nav #}
{% endblock %}

{% block govukHeader %}
  {{ govukHeader({
    homepageUrl: "/"
  }) }}
{% endblock %}

{% block govukServiceNavigation %}
  {{ govukServiceNavigation({
    serviceName: applicationName,
    serviceUrl: "/",
    navigation: [
       {
         text: "Get started",
        href: "/new-starter-guide"
      },
      {
         text: "Research on reuse",
         href: "/research-on-reuse"
       },
       {
         text: "Contribute",
         href: "/contribute"
      },
      {
         text: "What's new",
         href: "/news"
      },
      {
          text: "About",
         href: "/about"
       }
    ]
  }) }}
{% endblock %}

{% block headerEnd %}
{# use this block for content that needs to show above main #}
  {% include "./serviceBanner.njk" %}
{% endblock %}

{% block govukFooter %}
  {% include "./footer.njk" %}
{% endblock %}

{% block bodyEnd %}
  <script type="module" src="{{ '/assets/js/index.js' | assetMap }}"></script>

  <!-- Google tag (gtag.js) -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-F098L9R2ZX" nonce="{{ cspNonce }}"></script>
  <script nonce="{{ cspNonce }}">
    window.dataLayer = window.dataLayer || [];
    function gtag() { dataLayer.push(arguments); }

    // Default: deny all non-essential storage
    gtag('consent', 'default', {
      'ad_storage': 'denied',
      'ad_user_data': 'denied',
      'ad_personalization': 'denied',
      'analytics_storage': 'denied'
    });

    // Read saved consent cookie and grant analytics if previously accepted
    (function() {
      try {
        // Legacy cookies use a string of 'accepted' or 'rejected'
        const legacy = document.cookie.match(/(^|; )cookie_consent=(accepted|rejected)(?=;|$)/);
        if (legacy) {
          const value = legacy[2] === 'accepted' ? 'granted' : 'denied';
          gtag('consent', 'update', { 'analytics_storage': value });
          return;
        }
        // Newer cookies use JSON to store preferences for each type of cookie
        const match = document.cookie.match(/(^|; )cookie_consent=([^;]*)/);
        if (match) {
          const options = JSON.parse(decodeURIComponent(match[2]));
          if (options && options.analytics === true) {
            gtag('consent', 'update', { 'analytics_storage': 'granted' });
          }
        }
      } catch (e) { /* cookie not set or invalid */ }
    })();

    gtag('js', new Date());
    gtag('config', 'G-F098L9R2ZX');
  </script>
{% endblock %}
